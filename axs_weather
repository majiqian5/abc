#!/bin/sh
# 锁屏天气 · 配置工具（root 执行）
# token 那一行自己填：axs_weather token 你的彩云token
CFG=/var/jb/var/mobile/Library/WeatherLock/config.txt
LIB=/var/jb/var/mobile/Library/WeatherLock
mkdir -p "$LIB" 2>/dev/null

if [ ! -f "$CFG" ]; then
cat > "$CFG" <<'DEF'
# 锁屏天气配置（改完 2 秒内自动生效，不用重启）
# ① 把下面 token 后面换成你自己的彩云 token（约 20 位）
token 在此填彩云TOKEN
# ② 城市/坐标（默认南宁）
lat 22.8170
lon 108.3665
city 南宁

# ---- 文字
size 14          # 主行字号
size2 11         # 体感/湿度/紫外线/AQI 行字号
size3 11         # 降水描述行字号
size4 10         # 未来 3 小时字号
size5 10         # 今日最高最低字号
color rainbow    # rainbow 彩虹 | white 纯白 | #FF8800 自定义
huespan 0.22     # 彩虹色相跨度，越大色越多
sat 0.90         # 饱和度
bright 0.68      # 亮度

# ---- 背景
bg weather       # weather 按天气变 | dark 深色 | none 无 | #101018 纯色
bgalpha 0.9      # 背景不透明度 0-1
radius 18        # 圆角

# ---- 位置尺寸
width 999        # 999=自动铺满（左右各留 pad）
offx 0           # 水平偏移
offy 120         # 距屏幕顶部
height 108       # 块高度
pad 12           # 内边距
gap 3            # 行间距
top 0            # 文字距块顶额外偏移

# ---- 行为
hourly on        # 未来 3 小时
daily on         # 今日高低 + 日出日落
ttl 600          # 天气缓存秒数
refresh 0        # 由 axs_weather refresh 触发
DEF
fi

setk() {  # setk key value
  esc=$(printf '%s' "$2" | sed 's/[\/&|]/\\&/g')
  if grep -q "^$1 " "$CFG" 2>/dev/null; then
    sed -i '' "s|^$1 .*|$1 $esc|" "$CFG" 2>/dev/null || sed -i "s|^$1 .*|$1 $esc|" "$CFG"
  else
    echo "$1 $2" >> "$CFG"
  fi
}

case "$1" in
  token)   setk token "$2"; setk refresh "$(date +%s)"; echo "token 已保存（长度 ${#2}），锁屏 2 秒内刷新";;
  size)    setk size "$2";;
  color)   setk color "$2";;          # rainbow | white | #FF8800
  hue)     setk huespan "$2";;
  bright)  setk bright "$2";;
  sat)     setk sat "$2";;
  bg)      setk bg "$2";;             # weather | dark | none | #101018
  alpha)   setk bgalpha "$2";;
  radius)  setk radius "$2";;
  width)   setk width "$2";;
  pos)     setk offx "$2"; setk offy "$3";;
  pad)     setk pad "$2";;
  gap)     setk gap "$2";;
  height)  setk height "$2";;
  city)    setk city "$2";;
  latlon)  setk lat "$2"; setk lon "$3";;
  hourly)  setk hourly "$2";;         # on | off
  daily)   setk daily "$2";;          # on | off
  ttl)     setk ttl "$2";;
  refresh) setk refresh "$(date +%s)"; echo "已请求刷新";;
  show)    cat "$CFG";;
  token?)  echo "把彩云 token 填进来：axs_weather token 你的token";;
  *) echo "用法："
     echo "  axs_weather token 你的彩云token   ← 只差这一步"
     echo "  axs_weather show                  # 看全部配置"
     echo "  axs_weather size 14               # 主行字号"
     echo "  axs_weather color rainbow|white|#FF8800"
     echo "  axs_weather hue 0.3               # 彩虹跨度"
     echo "  axs_weather bright 0.7            # 亮度"
     echo "  axs_weather bg weather|dark|none|#101018"
     echo "  axs_weather alpha 0.9             # 背景透明度"
     echo "  axs_weather width 340             # 999=全宽"
     echo "  axs_weather pos 0 120             # 水平偏移 顶部距离"
     echo "  axs_weather height 108"
     echo "  axs_weather pad 12 | gap 3 | radius 18"
     echo "  axs_weather city 南宁"
     echo "  axs_weather latlon 22.8170 108.3665"
     echo "  axs_weather hourly on|off | daily on|off"
     echo "  axs_weather ttl 600"
     echo "  axs_weather refresh";;
esac
